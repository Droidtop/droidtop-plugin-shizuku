{
  "id": "droidtop.shizuku-bridge",
  "origin": "droidtop",
  "label": "Shizuku",
  "description": "Shizuku for droidtop: a status tile and actions for the Shizuku app, and system-level privilege for other plugins and for droidtop itself (ending another app's game from Quit to Library), plus root when Shizuku runs as root, each only after you allow it.",
  "version": "1.2.0",
  "kind": "native_bundle",
  "contractVersion": 2,
  "abis": [],
  "entryClass": "dev.droidtop.plugins.shizuku.ShizukuPlugin",
  "provides": [
    { "point": "ui.status_tile", "label": "Shizuku" },
    { "point": "apps.bridge", "label": "Shizuku" }
  ],
  "permissions": [
    { "id": "apps.check", "packages": ["moe.shizuku.privileged.api"], "reason": "See whether Shizuku is installed" },
    { "id": "apps.launch", "reason": "Open Shizuku so you can start it and allow droidtop" },
    { "id": "host.full_trust", "required": true, "reason": "Talks to Shizuku's binder from droidtop's own process, which is where Shizuku allows droidtop" },
    { "id": "plugins.export_privileged", "reason": "Lets other plugins and droidtop run commands through Shizuku, as the system (adb) or, when Shizuku runs as root, as root, each only after you allow it" }
  ],
  "exports": [
    {
      "api": "priv.packages",
      "version": "1.0",
      "attributes": { "level": "adb" },
      "ops": [
        { "op": "force_stop", "permission": "priv.packages", "job": false }
      ]
    },
    {
      "api": "priv.shell",
      "version": "1.0",
      "attributes": { "level": "adb" },
      "ops": [
        { "op": "exec", "permission": "priv.shell.adb", "job": false },
        { "op": "exec_stream", "permission": "priv.shell.adb", "job": false },
        { "op": "stream_read", "permission": "priv.shell.adb", "job": false },
        { "op": "stream_write", "permission": "priv.shell.adb", "job": false },
        { "op": "stream_kill", "permission": "priv.shell.adb", "job": false }
      ]
    },
    {
      "api": "priv.shell",
      "version": "1.0",
      "attributes": { "level": "root" },
      "ops": [
        { "op": "exec", "permission": "priv.shell.root", "job": false },
        { "op": "exec_stream", "permission": "priv.shell.root", "job": false },
        { "op": "stream_read", "permission": "priv.shell.root", "job": false },
        { "op": "stream_write", "permission": "priv.shell.root", "job": false },
        { "op": "stream_kill", "permission": "priv.shell.root", "job": false }
      ]
    }
  ]
}
